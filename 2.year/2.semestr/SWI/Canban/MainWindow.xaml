<Window x:Class="Canban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Canban"
        xmlns:UserControls="clr-namespace:Canban.View.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <Menu Width="800" Height="20">
            <MenuItem Header="_File">
                <MenuItem x:Name="AppExit" Header="E_xit" HorizontalAlignment="Left" Width="140"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem x:Name="Options" Header="_Options" HorizontalAlignment="Left" Width="140"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="About" Header="&amp;About" HorizontalAlignment="Left" Width="140"/>
            </MenuItem>
            <MenuItem Header="_LogOut" Click="MenuItem_Click" />
        </Menu>
        <WrapPanel x:Name="BoardWrapPanel" Height="auto" Orientation="Horizontal" Margin="20">
            <Button x:Name="AddButton" Width="100" Height="100" Margin="0,50,0,0" Content="+" FontSize="50" Click="AddButton_Click"/>

        </WrapPanel>
    </StackPanel>
    
        
</Window>
