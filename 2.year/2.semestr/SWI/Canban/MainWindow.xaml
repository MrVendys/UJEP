<Window x:Class="Canban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Canban"
        xmlns:UserControls="clr-namespace:Canban.View.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <TextBox Name="TodoTextBox" Grid.Column="0" FontSize="30" TextAlignment="Center" VerticalAlignment="Center">To Do</TextBox>
        <TextBox Name="InProgressTextBox" Grid.Column="1" FontSize="30" TextAlignment="Center" VerticalAlignment="Center">InProgress</TextBox>
        <TextBox Name="Blocked" Grid.Column="2" FontSize="30" TextAlignment="Center" VerticalAlignment="Center">Blocked</TextBox>
        <TextBox Name="Done" Grid.Column="3" FontSize="30" TextAlignment="Center" VerticalAlignment="Center">Done</TextBox>

        <UserControls:TasksGrid Grid.Row="2"></UserControls:TasksGrid>
        <UserControls:TasksGrid Grid.Column="1" Grid.Row="2"></UserControls:TasksGrid>
        <UserControls:TasksGrid Grid.Column="2" Grid.Row="2"></UserControls:TasksGrid>
        <UserControls:TasksGrid Grid.Column="3" Grid.Row="2"></UserControls:TasksGrid>
    </Grid>
        
</Window>
