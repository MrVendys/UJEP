<UserControl x:Class="Canban.View.UserControls.ColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Canban.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" MouseMove="UserControl_MouseMove_1">
    <UserControl.Resources>
        <Style x:Key="KanbanColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="KanbanColumnBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style x:Key="AddTaskButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Background" Value="#4FC3F7"/>
            <!-- Blue accent color -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="4" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="5" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Hover Effect -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29B6F6"/>
                    <!-- Slightly darker blue on hover -->
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0288D1"/>
                    <!-- Even darker blue when pressed -->
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border  Style="{StaticResource KanbanColumnBorderStyle}" >
        <StackPanel x:Name="TaskControlGrid" Width="200" Height="430" Background="White" Orientation="Vertical">
            <TextBlock 
                x:Name="ColumnHeaderTextBlock"
        Style="{StaticResource KanbanColumnHeaderStyle}"
        Grid.Row="0" 
        TextAlignment="Center" 
                Background="Transparent"
        FontSize="25" 
        Text="{Binding ColumnName}"
                MouseLeftButtonDown="ColumnHeaderTextBlock_MouseLeftButtonDown"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="70"  Grid.Row="1" Margin="5" BorderThickness="10" VerticalAlignment="Stretch">
                <StackPanel 
            x:Name="TaskStackPanel" 
            MinHeight="50" 
            AllowDrop="True" 
                
            Background="Transparent"
            MouseMove="TaskStackPanel_MouseMove" 
            Drop="TaskStackPanel_Drop"/>
            </ScrollViewer>
            <Button 
        x:Name="AddTaskBtn" 
                Style="{StaticResource AddTaskButtonStyle}"
        Grid.Row="2" 
        
        HorizontalContentAlignment="Center" 
        Content="+" 
        Click="AddTaskBtn_Click"/>

        </StackPanel>

    </Border>
    
</UserControl>
