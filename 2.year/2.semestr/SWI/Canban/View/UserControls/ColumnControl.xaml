<UserControl x:Class="Canban.View.UserControls.ColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Canban.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" MouseMove="UserControl_MouseMove_1">
    <UserControl.Resources>
        <Style x:Key="ColumnStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="430"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Orientation" Value="Vertical"/>
        </Style>
        <!-- Columns Header Style -->
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Text" Value="{Binding ColumnName}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Column Border Style -->
        <Style x:Key="ColumnBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <!-- Column Scroll Style -->
        <Style x:Key="ColumnScrollStyle" TargetType="ScrollViewer">
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <!-- Column StackPanel Style -->
        <Style x:Key="ColumnStackPanelStyle" TargetType="StackPanel">
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- AddTask Button Style -->
        <Style x:Key="AddTaskButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#4FC3F7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Content" Value="+"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="4" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="5" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Hover Effect -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29B6F6"/>
                    <!-- Slightly darker blue on hover -->
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0288D1"/>
                    <!-- Even darker blue when pressed -->
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Column Border -->
    <Border  Style="{StaticResource ColumnBorderStyle}" >
        <!-- Column -->
        <StackPanel x:Name="TaskControlGrid" Style="{StaticResource ColumnStyle}">
            <!-- Column Header -->
            <TextBlock 
                x:Name="ColumnHeaderTextBlock"
                Style="{StaticResource ColumnHeaderStyle}"
                MouseLeftButtonDown="ColumnHeaderTextBlock_MouseLeftButtonDown"/>
            <!-- Column Scroll -->
            <ScrollViewer  Style="{StaticResource ColumnScrollStyle}">
                <!-- Column StackPanel -->
                <StackPanel 
                    Style="{StaticResource ColumnStackPanelStyle}"
                    x:Name="TaskStackPanel" 
                    MouseMove="TaskStackPanel_MouseMove" 
                    Drop="TaskStackPanel_Drop"/>
            </ScrollViewer>
            <Button 
                x:Name="AddTaskBtn" 
                Style="{StaticResource AddTaskButtonStyle}"
                Click="AddTaskBtn_Click"/>
        </StackPanel>
    </Border>
</UserControl>
