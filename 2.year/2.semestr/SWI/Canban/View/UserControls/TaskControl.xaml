<UserControl x:Class="Canban.View.UserControls.TaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Canban.View.UserControls"
             mc:Ignorable="d" 
             MinHeight="50" d:DesignWidth="250">
    <UserControl.Resources>
        <!-- Task Border Style -->
        <Style x:Key="TaskBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="4" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Task Style -->
        <Style x:Key="TaskStyle" TargetType="StackPanel">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>
        <!-- Inout TextBox -->
        <Style x:Key="NameTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="5,5,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="DarkGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Text" Value="{Binding TaskName}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </UserControl.Resources>
    
    <!-- Task Border -->
    <Border BorderThickness="2" Style="{StaticResource TaskBorderStyle}">
        <!-- Task -->
        <StackPanel Style="{StaticResource TaskStyle}" >
            <TextBox 
        x:Name="NameTextBox" 
                Style="{StaticResource NameTextBoxStyle}"
        
        MouseDoubleClick="NameTextBox_MouseDoubleClick"/>
            <Button 
        x:Name="RemoveBtn" 
        Width="30"
        Height="28"
        Margin="0,0,0.5,0"
        HorizontalAlignment="Right" 
                VerticalAlignment="Center"
        Background="Transparent" 
        BorderThickness="0"
        Content="X"
        Foreground="Red"
        Click="RemoveBtn_Click"/>
        </StackPanel>
    </Border>
    
</UserControl>
