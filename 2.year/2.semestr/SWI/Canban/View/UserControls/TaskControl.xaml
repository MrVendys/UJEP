<UserControl x:Class="Canban.View.UserControls.TaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Canban.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="400">
    <Grid Background="White" Height="80" >
        <TextBox x:Name="NameTextBox" 
        VerticalAlignment="Center"
        Padding="5,5,0,0"
        Margin="5,0,0,0"
        Background="Transparent"
        BorderThickness="0"
        FontSize="16"
        TextChanged="NameTextBox_TextChanged"
        MouseDoubleClick="NameTextBox_MouseDoubleClick"/>
        <TextBlock x:Name="PlaceHolder" 
        VerticalAlignment="Center" 
        Padding="5,5,0,0"
        Margin="5,0,0,0"
        Foreground="DarkGray"
        Panel.ZIndex="-1"
        Text="Add Name" 
        FontSize="16"
        FontWeight="Light"/>
        <Button x:Name="RemoveBtn" 
     Width="30"
     Height="28"
     HorizontalAlignment="Right" 
     Margin="0,0,0.5,0"
     Background="Transparent" 
     BorderThickness="0"
     Content="X"
     Foreground="Red"
     Click="RemoveBtn_Click"/>
    </Grid>
</UserControl>
