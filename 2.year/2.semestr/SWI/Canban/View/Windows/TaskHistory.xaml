<Window x:Class="Canban.View.Windows.TaskHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Canban.View.Windows"
        mc:Ignorable="d"
        Title="TaskHistory" Height="450" Width="800" Closing="Window_Closing">
    <DataGrid x:Name="contextDataGrid"
              ItemsSource="{Binding Data.DefaultView}"
        AutoGenerateColumns="True"
        AlternatingRowBackground="LightBlue"
        AlternationCount="2"/>

</Window>
