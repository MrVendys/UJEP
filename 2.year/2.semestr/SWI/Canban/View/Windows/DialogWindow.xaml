<Window x:Class="Canban.View.Windows.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Canban.View.Windows"
        mc:Ignorable="d"
        Title="Creating" 
        MinHeight="100"
        MinWidth="300"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" 
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <Window.Resources>
        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Margin" Value="0,3,5,0"/>
        </Style>
        <!-- TextBox Style -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        <Style x:Key="ColorPickerStyle" TargetType="xctk:ColorPicker">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Height" Value="25"/>
        </Style>
        <!-- Button Style Preview -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5,5,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#4FC3F7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="4" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
             CornerRadius="5" 
             BorderBrush="#E0E0E0" 
             BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Hover Effect -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29B6F6"/>
                    <!-- Slightly darker blue on hover -->
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0288D1"/>
                    <!-- Even darker blue when pressed -->
                </Trigger>
            </Style.Triggers>
        
        </Style>
        <!-- Cance button Style-->
        <Style x:Key="CancelButtonStyle" BasedOn="{StaticResource ButtonStyle}" TargetType="Button">
            
        </Style>
        <Style x:Key="OkButtonStyle" BasedOn="{StaticResource ButtonStyle}" TargetType="Button">

        </Style>
    </Window.Resources>
    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Style="{StaticResource LabelStyle}" Grid.Row="0" Grid.Column="0" Content="Název:"/>
        <TextBox Name="InputTextBox" Style="{StaticResource TextBoxStyle}" Grid.Column="1" Grid.Row="0" />

        <Label Style="{StaticResource LabelStyle}" Grid.Column="0" Grid.Row="1" Content="Barva:"/>
        <xctk:ColorPicker x:Name="InputColorPicker" Style="{StaticResource ColorPickerStyle}" Grid.Column="1" Grid.Row="1"/>


        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="okButton" Style="{StaticResource OkButtonStyle}" IsDefault="True" Content="OK" Click="okButton_Click"/>
            <Button Name="cancelButton" Style="{StaticResource CancelButtonStyle}" IsCancel="True" Content="Cancel" Click="cancelButton_Click"/>
        </StackPanel>
    </Grid >
</Window>
