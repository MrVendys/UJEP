<Window x:Class="Canban.View.Windows.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Canban"
        xmlns:UserControls="clr-namespace:Canban.View.UserControls"
        mc:Ignorable="d"
        Title="Kanban Boards" Height="600" Width="800">
    
    <StackPanel>
            <Menu Width="800" Height="20">
                <MenuItem Header="_LogOut" Click="MenuItem_Click" />
                <MenuItem Header="History" Click="HistoryItem_Click" />
            </Menu>
        
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel 
                Height="500"
                VerticalAlignment="Center" 
                Orientation="Horizontal"
                Margin="10,0,10,0">
                <StackPanel 
                    x:Name="MainGrid" 
                    VerticalAlignment="Center" 
                    Orientation="Horizontal"/>
                <Button 
                    Height="100" 
                    Width="50" 
                    Content="+" 
                    FontSize="50" 
                    Click="Button_Click"/>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
    
   
</Window>
