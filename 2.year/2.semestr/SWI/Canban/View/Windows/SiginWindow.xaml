<Window x:Class="Canban.View.Windows.SiginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Canban.View.Windows"
        mc:Ignorable="d"
        Title="SiginWindow" Height="450" Width="300">
    <Grid>
        <StackPanel>
            <TextBox x:Name="NameInput" Margin="30" FontSize="20">Michal</TextBox>
            <TextBox x:Name="EmailInput" Margin="30" FontSize="20">Michal@gmail.com</TextBox>
            <PasswordBox x:Name="PasswordInput" Margin="30" FontSize="20" PasswordChar="*"></PasswordBox>
            <Button x:Name="SigInButton" Width="200" Height="30"  Content="Sig in" Click="SigInButton_Click"></Button>
            <Button x:Name="LoginButton" Width="200" Height="30" Margin="0,80,0,0" Content="Log in" Click="LoginButton_Click"></Button>

        </StackPanel>
    </Grid>
</Window>
