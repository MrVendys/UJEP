<UserControl x:Class="GUI___Canban.View.UserControls.Task"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GUI___Canban.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250">
    <Grid Background="White" Height="40">
        <TextBox x:Name="NameTextBox" 
               Padding="5,5,0,0"
               VerticalAlignment="Top"
               Background="Transparent"
               BorderThickness="0"
               FontSize="16"
               TextChanged="NameTextBox_TextChanged"
               MouseDoubleClick="NameTextBox_MouseDoubleClick"/>
        <TextBlock x:Name="PlaceHolder" 
               VerticalAlignment="Top" 
               Foreground="DarkGray"
               Padding="5,5,0,0"
               Margin="5,0,0,0"
               Panel.ZIndex="-1"
               Text="Add Name" 
               FontSize="16"
               FontWeight="Light"/>
        <Button x:Name="RemoveBtn" 
            Width="30"
            Height="28"
            HorizontalAlignment="Right" 
            Margin="0,0,0.5,0"
            Background="Transparent" 
            BorderThickness="0"
            Content="X"
            Foreground="Red"
            Click="RemoveBtn_Click"/>
    </Grid>
</UserControl>
