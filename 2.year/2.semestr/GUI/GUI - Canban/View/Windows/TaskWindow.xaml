<Window x:Class="GUI___Canban.View.Windows.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI___Canban.View.Windows"
        mc:Ignorable="d"
        Title="TaskWindow" Height="450" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Title"/>
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Status:"/>
        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Assignee:"/>
        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Started:"/>
        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Ended:"/>
        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Deadline:"/>
        <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Tags:"/>
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2">Description</TextBlock>

        <TextBox Grid.Column="1" VerticalAlignment="Center" Margin="5" FontSize="20">asd</TextBox>
        <ComboBox x:Name="StatusCombobox" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="191,0,5,0" FontSize="20" Selected="StatusCombobox_Selected">
            <ComboBoxItem>Václav Pták</ComboBoxItem>
            <ComboBoxItem>Lukáš Pták</ComboBoxItem>
            <ComboBoxItem>Michal Adamec</ComboBoxItem>
        </ComboBox>

    </Grid>
</Window>
